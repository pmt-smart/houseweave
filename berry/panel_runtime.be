# The half of a generated project that every project shares: writing a binding
# to the compiled page, and reading a touch back from it.
#
# A project is generated by libs/nspanel-sim/export/scripts/build-project-hmi.mjs
# as a file of data beside its .tft, `<project>.jsonl`, in JSON Lines: which
# component on which page carries each binding, what each touch means, the
# theme's colours, glyphs and font advances, the pages the views are drawn on.
# This is the code that reads it, in the firmware, the same for every project.
#
#   the first line  what every page needs, read once, at boot: {"format": 3,
#                   "pages": {page: offset}, "tables": {name: offset}, "shared":
#                   {page: {path: writes}}, "colors", "glyphs", "advances", the
#                   pages of the views, "plan_style", ...}
#   a page's line   read when that page comes up (showing), and dropped when the
#                   next one does: {"page": page, "writes": {path: writes},
#                   "events": {"<objname>,<gesture>": entry}}
#   a table's line  what only some pages need, read when one of them asks
#                   (table) and dropped with the page: {"table": "settings",
#                   "items": [...]}, and {"table": "keyboard", "limits": {...},
#                   "initial": {...}}
#
# So the heap holds the project's own tables and one page's, however many pages
# the project has. A line is found by the indexes of the first,
# which say where it starts, counted from the second line's start; it runs to
# where the next one starts, and is read at one go. The indexes are checked
# against the lines at boot, so a file changed after it was generated is refused
# there, whole, and not found out a page at a time.
#
# A target is [objname, attribute[, kind[, a[, b[, c]]]]], on the page of the
# line it is in; `shared` holds the targets on the components every page may
# address (vscope global), by the page they are on, and they are written from
# any page. A binding's writes are its one target, or the list of its targets
# when it has more: a list of one would cost the heap a list. An
# entry is [event, subject], or [event, subject, true | "text"] for a touch whose
# frame ends in a number, or in what the keyboard typed. All of it is read, and
# never written.
#
# The fitting of text to its box is the rule of fitZiText in
# libs/nspanel-sim/export/src/textRaster.ts (FIT_FIRST 0x20, the ellipsis ".."),
# and the same cases pin both sides: libs/nspanel-sim/export/test/fitText.test.mjs
# and berry/test/test_panel_runtime.be.

#@ solidify:PanelRuntime
class PanelRuntime
    # the project file's format this reads: one of another is refused, by name
    static FORMAT = 3
    # what the first line gives the views and brain.be, as fields of the same names
    static FIELDS = ["colors", "glyphs", "keyboard_page", "keyboard_pads", "home_page", "list_page", "list_rows", "cover_page",
                     "dialog_page", "house_page", "house_rows", "house_icons", "mesh_page", "mesh_rows", "qr_page", "qr_max", "qr_lines", "zone_page", "zone_rows", "zone_counters", "thermostat_page", "thermostat_lines", "thermostat_modes", "detail_page",
                     "help_page", "help_lines", "lock_page", "plan_page"]

    var send        # f(instruction) -> nil; nextion_driver's sendnx()
    var path        # the project's file
    var index       # page -> where its line starts, from where the second line does
    var tables      # table -> the same, for the tables only some pages need
    var body        # where the second line starts
    var length      # the bytes from there to the file's end
    var shared      # page -> binding path -> its writes on that page's components every page may address
    var page        # the page on show, as far as this side knows, or nil
    var writes      # the page on show's: binding path -> its writes there
    var events      # the page on show's: "<objname>,<gesture>" -> its entry
    var held        # table -> its line, read since the page on show came up
    var maxes       # page.objname -> the maxval the runtime last wrote into a paged slider
    # the project's own tables, from its first line
    var colors, glyphs, advances, keyboard_page, keyboard_pads, home_page, list_page, list_rows
    var dialog_page, qr_page, qr_max, qr_lines, zone_page, zone_rows, zone_counters, thermostat_page, thermostat_lines, thermostat_modes, detail_page, help_page
    var help_lines, lock_page, plan_page, plan_style, cover_page, house_page, house_rows, house_icons, mesh_page, mesh_rows

    # The project `project`, from <project>.jsonl at the root of the file
    # system, or in `dir` (a test's). A file that is missing, of another format
    # or of another project, or whose lines are not where its indexes say,
    # raises: the panel runs no pages of ours rather than half of them.
    def init(send, project, dir)
        import json
        self.send = send
        self.path = (dir != nil ? dir : "/") + project + ".jsonl"
        var f = open(self.path, "rb")
        var head = json.load(f.readline())
        self.body = f.tell()
        self.length = f.size() - self.body
        if !isinstance(head, map)
            f.close()
            raise "value_error", self.path + " does not start with a project's tables"
        end
        if head.find("format") != PanelRuntime.FORMAT
            f.close()
            raise "value_error", self.path + " is in format " + str(head.find("format")) + ", and this firmware reads " + str(PanelRuntime.FORMAT)
        end
        if head.find("scenario") != project
            f.close()
            raise "value_error", self.path + " holds the project " + str(head.find("scenario"))
        end
        self.index = head["pages"]
        self.tables = head["tables"]
        # every line where its index says, after a newline and starting with its
        # name, and the last one ended: so each line ends where the next starts
        var bad = PanelRuntime.misplaced(f, self.body, self.length, self.index, "page")
        if bad == nil  bad = PanelRuntime.misplaced(f, self.body, self.length, self.tables, "table") end
        var ended = false
        if self.length > 0
            f.seek(self.body + self.length - 1)
            ended = f.read(1) == "\n"
        end
        f.close()
        if bad != nil  raise "value_error", self.path + ": the line of " + bad + " is not where the index says" end
        if !ended  raise "value_error", self.path + " does not end its last line" end
        self.shared = head["shared"]
        for name: PanelRuntime.FIELDS
            self.(name) = head.find(name)
        end
        # the advances in hex, a byte a code point, and the plan's by the role it names
        var advances = {}
        for role: head["advances"].keys()
            advances[role] = bytes(head["advances"][role])
        end
        self.advances = advances
        var style = head.find("plan_style")
        if style != nil  style["advances"] = advances.find(style["advances"]) end
        self.plan_style = style
        self.page = nil
        self.writes = {}
        self.events = {}
        self.held = {}
        self.maxes = {}
    end

    # The first name of an index whose line does not open with {"<kind>":"<name>"
    # right after a newline, where the index says; nil when every line is where
    # it should be.
    static def misplaced(f, body, length, index, kind)
        for name: index.keys()
            var at = index[name]
            var start = "\n{\"" + kind + "\":\"" + name + "\""
            if type(at) != "int" || at < 0 || at >= length return name end
            f.seek(body + at - 1)
            if f.read(size(start)) != start return name end
        end
        return nil
    end

    # A page came up: brain's own `page`, or a frame from it (on_payload). Its
    # line is read now, and the page that went takes its own away with it, and
    # the tables it asked for. Before any page is known, only what every page
    # may address is written: the glass is on a page this side was not told of,
    # and a component local to any other page refuses a write.
    def showing(page)
        if page == self.page return end
        self.page = page
        var line = self.line_at(self.index.find(page))
        self.writes = line != nil ? line["writes"] : {}
        self.events = line != nil ? line["events"] : {}
        self.held = {}
    end

    # A line of the file, by where an index says it starts, parsed without its
    # newline; nil for no place.
    def line_at(at)
        import json
        if at == nil return nil end
        var f = open(self.path, "rb")
        f.seek(self.body + at)
        var line = json.load(f.read(self.line_end(at) - at - 1))
        f.close()
        return line
    end

    # Where the line starting at `at` ends: where the next one starts, or the file does
    def line_end(at)
        var stop = self.length
        for o: self.index   if o > at && o < stop  stop = o end end
        for o: self.tables  if o > at && o < stop  stop = o end end
        return stop
    end

    # A table only some pages need, read when one of them first asks, and kept
    # until the page changes; nil for a table the project has not got.
    def table(name)
        var t = self.held.find(name)
        if t != nil return t end
        t = self.line_at(self.tables.find(name))
        if t != nil  self.held[name] = t end
        return t
    end

    # The Settings list, in order: [label, key, [help lines]]. What its list, its
    # choices and Help show, when one of them is up.
    def settings_items()
        var t = self.table("settings")
        return t != nil ? t["items"] : []
    end

    # How many characters the keyboard lets the finger type into a binding's
    # slot, or nil for a slot with no declared capacity.
    def limit(path)
        var t = self.table("keyboard")
        return t != nil ? t["limits"].find(path) : nil
    end

    # What the compiled page shows in a binding's slot before anything is
    # written to it, or nil.
    def initial_text(path)
        var t = self.table("keyboard")
        return t != nil ? t["initial"].find(path) : nil
    end

    # A binding's first target, on the page on show or on a component every page
    # may address, or nil for a path nobody placed there.
    def first(path)
        var w = self.writes.find(path)
        if w == nil
            for page: self.shared.keys()
                w = self.shared[page].find(path)
                if w != nil break end
            end
        end
        return (w == nil || !isinstance(w[0], list)) ? w : w[0]
    end

    # A touch's entry, on the page on show: [event, subject], or [event,
    # subject, true | "text"] for a frame that ends in a value; nil for a key
    # that is not one.
    def hit(key)
        return self.events.find(key)
    end

    # A value that has to be a number, with nil as zero: a binding given nothing
    # writes nothing's worth, and does not stop the effects after it
    static def num(value)
        return value == nil ? 0 : int(value)
    end

    # A double quote in the value would end the Nextion string early and leave
    # the rest as instructions. Dropped rather than escaped: no escape for one
    # has been measured on the glass. So is any byte that is never text: a
    # control character, and from 0xF5 up, where UTF-8 has no byte and three
    # 0xFF end an instruction (a device's model reaches here from the device
    # itself). A backslash goes doubled: the Nextion's instruction set reads
    # \" \\ and \r inside a string, and the emulated glass with it, so a lone
    # one would take the character after it -- a closing quote, at the end of
    # a value. The symbols' keyboard types one; the bench confirms the glass. A value with none of them, which is almost every
    # value, is quoted as it is, without being built again a byte at a time.
    def quote(v)
        import string
        var n = size(v)
        var i = 0
        while i < n
            var c = string.byte(v[i])
            if c == 0x22 || c == 0x5C || c < 0x20 || c >= 0xF5 break end
            i += 1
        end
        if i == n return "\"" + v + "\"" end
        var out = i > 0 ? v[0 .. i - 1] : ""
        while i < n
            var c = string.byte(v[i])
            # A backslash starts an escape in a Nextion string (\" \\ \r), so
            # one the symbols' keyboard typed goes as two
            if c == 0x5C
                out += "\\\\"
            elif c != 0x22 && c >= 0x20 && c < 0xF5
                out += v[i]
            end
            i += 1
        end
        return "\"" + out + "\""
    end

    # What one attribute takes: txt is a quoted string, everything else a
    # number -- and a colour may arrive as a theme token, which only this side
    # can resolve because the panel has no palette. A "glyph" write takes an
    # icon ROLE and writes this theme's glyph for it, so no codepoint ever
    # crosses the wire; an unknown role is written as nothing, not guessed.
    # A "switch" write takes 0/1 and writes one of the theme's two colours,
    # carried in the target itself; a "flip" write lands max - value, for a
    # vertical slider whose minimum is at the other end from the list's top.
    # A nil text is written empty, and a nil number as 0. `page` is the one the
    # target is on.
    def render(page, t, value)
        var attribute = t[1]
        var kind = size(t) > 2 ? t[2] : nil
        var tag = PanelRuntime.tag(t)
        if kind == "glyph"
            var g = self.glyphs.find(str(value) + tag)
            return self.quote(g == nil ? "" : g)
        end
        if kind == "switch"
            # 2 is the third colour, a row that destroys, where the slot carries one
            if value == 2 && size(t) > 5 return str(t[5]) end
            return str((value == true || value == 1) ? t[3] : t[4])
        end
        if kind == "flip"
            # the maximum the runtime last gave this slider, or the compiled one
            return str(self.maxes.find(page + "." + t[0], t[3]) - PanelRuntime.num(value))
        end
        if kind == "fit"
            return self.quote(self.fit(value == nil ? "" : str(value), t[3], t[4] + tag, t[5]))
        end
        if attribute == "txt"
            return self.quote(value == nil ? "" : str(value))
        end
        if type(value) == "string"
            var known = self.colors.find(value + tag)
            if known != nil return str(known) end
        end
        return str(PanelRuntime.num(value))
    end

    # The tag of a target on a placement of another theme than the project's:
    # its last element, "@1", which names that theme's entries in
    # the glyphs, the colours and the advances. "" for the project's own.
    static def tag(t)
        var last = size(t) > 2 ? t[-1] : nil
        return type(last) == "string" && size(last) > 1 && last[0] == "@" ? last : ""
    end

    # How many BYTES of s, at whole characters, fit width pixels and maxl bytes
    # in the font whose advances are adv (U+0020..U+00FF, one byte each). A
    # double quote measures nothing, because quote() drops it; so does anything
    # past U+00FF, which no theme text font carries.
    def span(s, adv, width, maxl)
        import string
        var pen = 0
        var i = 0
        var n = size(s)
        while i < n
            var b = string.byte(s[i])
            var len = b >= 0xF0 ? 4 : b >= 0xE0 ? 3 : b >= 0xC0 ? 2 : 1
            var cp = len == 1 ? b : -1
            if len == 2 && i + 1 < n
                cp = ((b & 0x1F) << 6) | (string.byte(s[i + 1]) & 0x3F)
            end
            var a = (cp >= 32 && cp <= 0xFF && cp != 0x22) ? adv[cp - 32] : 0
            if pen + a > width || i + len > maxl break end
            pen += a
            i += len
        end
        return i
    end

    # A text as it fits its box: whole when it fits, and otherwise the longest
    # start that leaves room for the ellipsis, trailing spaces dropped, with
    # the ellipsis after it -- never cut mid-letter, which is what the glass
    # does to a text that runs past its box.
    def fit(s, width, role, maxl)
        import string
        var adv = self.advances.find(role)
        if adv == nil return s end
        if self.span(s, adv, width, maxl) == size(s) return s end
        var dots = ".."
        var tail = 0
        for i : 0..size(dots)-1
            tail += adv[string.byte(dots[i]) - 32]
        end
        if width - tail < 0 || maxl - size(dots) < 0
            var whole = self.span(s, adv, width, maxl)
            return whole == 0 ? "" : s[0..whole-1]
        end
        var k = self.span(s, adv, width - tail, maxl - size(dots))
        while k > 0 && s[k-1] == " "
            k -= 1
        end
        return (k == 0 ? "" : s[0..k-1]) + dots
    end

    # Tell the panel a value. Returns how many components were written, so a
    # binding nobody placed is a zero and not a silence.
    #
    # Only on the page on show, whose line holds its targets, and on the
    # components every page may address: a write to a component local to a page
    # not showing is refused by the glass (brain.be, open_light_detail), and
    # two list pages share every slot of the list.
    def set(path, value)
        var wrote = self.put(self.page, self.writes.find(path), value)
        for page: self.shared.keys()
            wrote += self.put(page, self.shared[page].find(path), value)
        end
        return wrote
    end

    # A binding's writes on `page`, its one target or the list of them, made;
    # returns how many
    def put(page, w, value)
        if w == nil return 0 end
        if !isinstance(w[0], list)
            self.put_one(page, w, value)
            return 1
        end
        for t : w
            self.put_one(page, t, value)
        end
        return size(w)
    end

    # One target's write, on the component `t` names on `page`
    def put_one(page, t, value)
        var kind = size(t) > 2 ? t[2] : nil
        if kind == "vis"
            # shown or hidden, on the page that is up: vis takes no page prefix
            self.send("vis " + t[0] + "," + ((value == true || value == 1) ? "1" : "0"))
        elif kind == "pages"
            # a paged list's length: the scrollbar's last page, remembered for
            # its flip, and the scrollbar shown only when there is a second page.
            # vis takes no page prefix: it is written while that page is up
            var count = PanelRuntime.num(value)
            var last = count > 1 ? count - 1 : 1
            self.maxes[page + "." + t[0]] = last
            self.send(page + "." + t[0] + ".maxval=" + str(last))
            self.send("vis " + t[0] + "," + (count > 1 ? "1" : "0"))
        elif kind == "paged"
            # a part of that scrollbar that goes with it, its tail: shown
            # with a second page, hidden (and deaf) on a list of one
            self.send("vis " + t[0] + "," + (PanelRuntime.num(value) > 1 ? "1" : "0"))
        elif kind == "present"
            # there only while the value holds something: the header's
            # action slot, drawn and touchable only when the view has one
            self.send("vis " + t[0] + "," + ((value != nil && str(value) != "") ? "1" : "0"))
        else
            self.send(page + "." + t[0] + "." + t[1] + "=" + self.render(page, t, value))
        end
    end

    # A paragraph over the lines that show it, `prefix` + 0, 1, ...: broken at
    # its spaces, each line as wide as its own box in its own font, and what
    # runs past the last line joined to it, which the fit ends with "..". A
    # confirmation's sentence arrives this way: this side is
    # the one that measures, and a Text does not wrap. Returns what was written.
    def wrap(prefix, text)
        var slots = []
        while true
            var t = self.first(prefix + str(size(slots)))
            if t == nil break end
            slots.push(t)
        end
        if size(slots) == 0 return 0 end
        # the words, by hand, so that a run of spaces is one break
        var words = []
        var w = ""
        var n = size(text)
        var i = 0
        while i < n
            if text[i] == " "
                if w != "" words.push(w) end
                w = ""
            else
                w += text[i]
            end
            i += 1
        end
        if w != "" words.push(w) end
        var lines = []
        var line = ""
        for word : words
            var t = slots[size(lines) < size(slots) ? size(lines) : size(slots) - 1]
            var adv = size(t) > 4 ? self.advances.find(t[4] + PanelRuntime.tag(t)) : nil
            var next = line == "" ? word : line + " " + word
            if line != "" && adv != nil && self.span(next, adv, t[3], t[5]) < size(next)
                lines.push(line)
                line = word
            else
                line = next
            end
        end
        if line != "" lines.push(line) end
        while size(lines) > size(slots)
            var last = lines.pop()
            lines[size(lines) - 1] = lines[size(lines) - 1] + " " + last
        end
        var wrote = 0
        for j : 0..size(slots)-1
            wrote += self.set(prefix + str(j), j < size(lines) ? lines[j] : "")
        end
        return wrote
    end

    # "ev,<page>,<objname>,<gesture>" -> [event, subject], or
    # "ev,<page>,<objname>,<gesture>,<n>" -> [event, subject, n], or nil.
    #
    # The subject is what the touch was ABOUT, as the project's own binding:
    # four cards all report "light.toggle" and only the subject says which
    # light. nil for a component that is about nothing, like a nav arrow.
    #
    # A slider's report ends in its value, appended ON THE GLASS (the frame is
    # built there, libs/nspanel-sim/layout/src/wire.ts). The manifest marks
    # those entries, and only for them is a comma after the gesture looked for
    # -- so a tap payload that happens to end in a number is not misread.
    def on_payload(payload)
        import string
        if size(payload) < 3 || payload[0..2] != "ev," return nil end
        # A frame comes from the page on show, whoever loaded it -- the glass
        # goes to a page by itself too (a screensaver's tap): its line is read
        # before the touch is looked up in it.
        var comma = string.find(payload, ",", 3)
        if comma <= 3 return nil end
        self.showing(payload[3 .. comma - 1])
        var key = payload[comma + 1 ..]
        var hit = self.hit(key)
        # an entry marked as carrying a value is only whole with one: a plan's
        # tap without its point, or a slider's change without its number, is nil
        if hit != nil return size(hit) < 3 ? [hit[0], hit[1]] : nil end
        # the comma after the gesture, and the value after it
        var gesture = string.find(key, ",")
        var cut = gesture < 0 ? -1 : string.find(key, ",", gesture + 1)
        if cut < 0 return nil end
        hit = self.hit(key[0 .. cut - 1])
        if hit == nil || size(hit) < 3 return nil end
        var tail = key[cut + 1 ..]
        # What the keyboard typed comes back as TEXT, and a name is not
        # required to look like a number. The text is the payload's last
        # field, so the rest of it is taken whole: a comma typed, which the
        # keyboards have for a position, stays in it.
        if hit[2] == "text" return [hit[0], hit[1], tail] end
        if size(tail) == 0 return nil end
        for i : 0..size(tail)-1
            if tail[i] < "0" || tail[i] > "9" return nil end
        end
        return [hit[0], hit[1], int(tail)]
    end
end
